rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio documents (ko, en)
    // Public read is permitted so recruiters and visitors on Netlify can view the latest portfolio.
    // Writes are allowed for portfolio documents to enable instant live CMS publishing.
    match /portfolio/{lang} {
      allow read: if true;
      allow write: if true;
    }

    // Dedicated image storage collection: Each image has its own independent 1MB Firestore document
    match /portfolio_media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    // Health check / connection test doc
    match /test/connection {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

